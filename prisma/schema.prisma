generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  plan      String   @default("STARTER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  industry  String?
  size      String?
  website   String?
  location  String?
  onboardingStep     Int      @default(0)
  onboardingComplete Boolean  @default(false)
  customDomain       String?
  resendDomainId     String?
  isDomainVerified   Boolean  @default(false)
  customSenderEmail  String?
  customSenderName   String?
  drives    Drive[]
  invites   OrgInvite[]
  users     User[]
}

model SuperAdmin {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  verificationTokens VerificationToken[]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  role         String        @default("CANDIDATE")
  orgRole      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  password     String?
  orgId        String?
  applications Application[]
  drives       Drive[]       @relation("CreatedDrives")
  acceptedInvites OrgInvite[] @relation("AcceptedInvites")
  sentInvites     OrgInvite[] @relation("SentInvites")
  organization Organization? @relation(fields: [orgId], references: [id])
}

model OrgInvite {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String
  email          String
  orgRole        String
  tokenHash      String       @unique
  status         String       @default("PENDING")
  invitedByUserId String
  acceptedUserId String?
  expiresAt      DateTime
  respondedAt    DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  acceptedUser   User?        @relation("AcceptedInvites", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  invitedByUser  User         @relation("SentInvites", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
}

model Drive {
  id                 Int           @id @default(autoincrement())
  title              String
  role               String?
  description        String
  department         String
  type               String        @default("Full-time")
  screeningThreshold Int           @default(60)
  creatorId          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deadline           DateTime?
  positions          Int?          @default(1)
  registrationFields String?       @default("[]")
  workMode           String?       @default("Remote")
  experience         String?
  responsibilities   String?
  requirements       String?
  salary             String?
  skills             String?
  extractedDetails   String?       @default("{}")
  interviewEnabled   Boolean       @default(true)
  interviewLanguage  String?       @default("English")
  interviewTime      Int?          @default(10)
  proctoringLevel    String?       @default("Medium")
  aiFollowUpDepth    Int?          @default(3)
  interviewQuestions String?       @default("[]")
  jdFileName         String?
  jdPreviewUrl       String?
  orgId              String?
  location           String        @default("Remote")
  status             String        @default("ACTIVE")
  aiScreeningEnabled Boolean       @default(true)
  applications       Application[]
  creator            User          @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
}

model Application {
  id               String     @id @default(cuid())
  status           String     @default("APPLIED")
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  aiScore          Int?
  aiReport         String?
  driveId          Int
  userId           String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  resumeText       String?
  experienceYears  Float?
  relevantYears    Float?
  structuredResume String?    @default("{}")
  submissionData   Json?      @default("{}")
  drive            Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  user             User?      @relation(fields: [userId], references: [id])
  interview        Interview?

  @@index([driveId, status, updatedAt])
}

model Interview {
  id                    String      @id @default(cuid())
  applicationId         String      @unique
  accessToken           String      @unique @default(uuid())
  expiresAt             DateTime?
  status                String      @default("PENDING")
  startedAt             DateTime?
  completedAt           DateTime?
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  interviewDuration     Int?
  aiSummary             String?
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id           String      @id @default(cuid())
  token        String      @unique
  expires      DateTime
  createdAt    DateTime    @default(now())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
}
