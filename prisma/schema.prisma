generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  industry  String?
  size      String?
  website   String?
  plan      String   @default("STARTER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  drives    Drive[]
}

model SuperAdmin {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String
  verificationTokens VerificationToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  role         String        @default("CANDIDATE") // SUPER_ADMIN | ORG_ADMIN | CANDIDATE
  orgId        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  password     String?
  organization Organization? @relation(fields: [orgId], references: [id])
  applications Application[]
  drives       Drive[]       @relation("CreatedDrives")
}

model Drive {
  id                   Int           @id @default(autoincrement())
  title                String
  role                 String?
  description          String
  department           String
  location             String        @default("Remote")
  type                 String        @default("Full-time")
  status               String        @default("ACTIVE")
  screeningThreshold   Int           @default(60)
  aiScreeningEnabled   Boolean       @default(true)
  creatorId            String
  orgId                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deadline             DateTime?
  positions            Int?          @default(1)
  registrationFields   String?       @default("[]")
  workMode             String?       @default("Remote")
  // Legacy interview fields
  interviewEnabled     Boolean       @default(true)
  interviewLanguage    String?       @default("English")
  interviewTime        Int?          @default(10)
  proctoringLevel      String?       @default("Medium")
  aiFollowUpDepth      Int?          @default(3)
  interviewQuestions   String?       @default("[]")
  // JD fields
  jdFileName           String?
  jdPreviewUrl         String?
  // Content
  experience           String?
  responsibilities     String?
  requirements         String?
  salary               String?
  skills               String?
  jdFileName           String?
  jdPreviewUrl         String?
  extractedDetails     String?       @default("{}")
  applications         Application[]
  creator              User          @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
  organization         Organization? @relation(fields: [orgId], references: [id])
}

model Application {
  id               String      @id @default(cuid())
  status           String      @default("APPLIED")
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  aiScore          Int?
  aiReport         String?
  driveId          Int
  userId           String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  resumeText       String?
  experienceYears  Float?
  relevantYears    Float?
  structuredResume String?     @default("{}")
  submissionData   Json?       @default("{}")
  drive            Drive       @relation(fields: [driveId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id])
  interview        Interview?
}

model Interview {
  id                    String      @id @default(cuid())
  applicationId         String      @unique
  accessToken           String      @unique @default(uuid())
  expiresAt             DateTime?
  status                String      @default("PENDING")
  startedAt             DateTime?
  completedAt           DateTime?
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  interviewDuration     Int?
  aiSummary             String?
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  id           String      @id @default(cuid())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  token        String      @unique
  expires      DateTime
  createdAt    DateTime    @default(now())
}
