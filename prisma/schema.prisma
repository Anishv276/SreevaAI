generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  logoUrl            String?
  plan               String      @default("STARTER")
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  industry           String?
  size               String?
  website            String?
  onboardingStep     Int         @default(0)
  onboardingComplete Boolean     @default(false)
  customDomain       String?
  resendDomainId     String?
  isDomainVerified   Boolean     @default(false)
  customSenderEmail  String?
  customSenderName   String?
  ttsProvider        String?     @default("CARTESIA")
  cartesiaVoiceId    String?     @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  sarvamModel        String?     @default("bulbul:v3")
  sarvamVoice        String?     @default("shubh")
  deepgramModel      String?     @default("nova-3-general")
  sarvamSttModel     String?     @default("saaras:v3")
  sttProvider        String?     @default("DEEPGRAM")
  llmModel           String?     @default("gpt-4o")
  llmProvider        String?     @default("OPENAI")
  llmTemperature     Float?      @default(0.7)
  cartesiaModel      String?     @default("sonic-english")
  drives             Drive[]
  invites            OrgInvite[]
  users              User[]
}

model SuperAdmin {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  verificationTokens VerificationToken[]
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  role            String        @default("CANDIDATE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  password        String?
  orgId           String?
  orgRole         String?
  applications    Application[]
  drives          Drive[]       @relation("CreatedDrives")
  acceptedInvites OrgInvite[]   @relation("AcceptedInvites")
  sentInvites     OrgInvite[]   @relation("SentInvites")
  organization    Organization? @relation(fields: [orgId], references: [id])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model OrgInvite {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String
  email           String
  orgRole         String
  tokenHash       String       @unique
  status          String       @default("PENDING")
  invitedByUserId String
  acceptedUserId  String?
  expiresAt       DateTime
  respondedAt     DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  acceptedUser    User?        @relation("AcceptedInvites", fields: [acceptedUserId], references: [id])
  invitedByUser   User         @relation("SentInvites", fields: [invitedByUserId], references: [id])
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model Drive {
  title              String
  role               String?
  description        String
  department         String
  type               String        @default("Full-time")
  screeningThreshold Int           @default(60)
  creatorId          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deadline           DateTime?
  positions          Int?          @default(1)
  registrationFields String?       @default("[]")
  workMode           String?       @default("Remote")
  experience         String?
  responsibilities   String?
  requirements       String?
  salary             String?
  skills             String?
  extractedDetails   String?       @default("{}")
  interviewEnabled   Boolean       @default(true)
  interviewLanguage  String?       @default("English")
  interviewTime      Int?          @default(10)
  proctoringLevel    String?       @default("Medium")
  aiFollowUpDepth    Int?          @default(3)
  interviewQuestions String?       @default("[]")
  jdFileName         String?
  jdPreviewUrl       String?
  orgId              String?
  status             String        @default("ACTIVE")
  aiScreeningEnabled Boolean       @default(true)
  isPassportRequired Boolean       @default(false)
  slug               String?       @unique
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shortlistMode      String        @default("automatic")
  applications       Application[]
  creator            User          @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([slug])
}

model Application {
  id               String     @id @default(cuid())
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  aiScore          Int?
  aiReport         String?
  userId           String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  resumeText       String?
  experienceYears  Float?
  structuredResume String?    @default("{}")
  submissionData   Json?      @default("{}")
  passportUrl      String?
  driveId          String     @db.Uuid
  resumeStatus     String     @default("pending")
  interviewStatus  String     @default("pending")
  hiringStatus     String     @default("pending")
  drive            Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  user             User?      @relation(fields: [userId], references: [id])
  interview        Interview?

  @@index([driveId, resumeStatus, hiringStatus, updatedAt])
}

model Interview {
  id                    String      @id @default(cuid())
  applicationId         String      @unique
  accessToken           String      @unique @default(uuid())
  expiresAt             DateTime?
  status                String      @default("PENDING")
  startedAt             DateTime?
  completedAt           DateTime?
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  interviewDuration     Int?
  aiSummary             String?
  snapshots             String[]    @default([])
  candidateFeedback     String?
  candidateRating       Int?
  proctoringEvents      Json?       @default("[]")
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id           String      @id @default(cuid())
  token        String      @unique
  expires      DateTime
  createdAt    DateTime    @default(now())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
}
