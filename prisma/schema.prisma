generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OrganizationDetails {
  id                       String   @id
  name                     String
  urlSlug                  String   @unique
  billingPlan              String   @default("STARTER")
  maxActiveJobs            String   @default("Unlimited")
  maxConcurrentInterviews  Int      @default(5)
  enabledProctoringSignals Json?    @default("{\"tab_switch\": false, \"fullscreen_exit\": false, \"window_focus_loss\": false, \"face_absence\": false, \"multiple_faces\": false, \"camera_disabled\": false, \"connection_lost\": false, \"latency_mismatch\": false, \"identity_mismatch\": false, \"microphone_disabled\": false, \"answer_integrity\": false, \"session_fingerprint\": false}")
  orgStatus                String   @default("ACTIVE")
  orgCreatedAt             DateTime @default(now())
  orgUpdatedAt             DateTime @updatedAt
  isOnboardingComplete     Boolean  @default(false)
  // AI Model Configuration (all set via Super Admin → Models page)
  sttModel                 String   @default("flux-general-en")
  ttsProvider              String   @default("ELEVENLABS")
  ttsModel                 String   @default("eleven_turbo_v2_5")
  defaultVoiceId           String   @default("EXAVITQu4vr4xnSDxMaL")
  allowedVoiceIds          String[] @default([])
  llmResumeExtraction      String   @default("gpt-5.4-mini")
  llmJdExtraction          String   @default("gpt-5.4-mini")
  llmResumeReport          String   @default("gpt-5.4-mini")
  llmInterviewLive         String   @default("gpt-4.1-mini")
  llmInterviewEval         String   @default("gpt-4.1-nano")
  llmInterviewBrief        String   @default("gpt-4.1")
  llmInterviewReport       String   @default("gpt-5.4-mini")
  totalInterviewsAllowed   Int      @default(0)
  totalInterviewsUsed      Int      @default(0)
  billingCreditsUsed       Float    @default(0)
  quotaControlMode         String   @default("QUOTA")
  platformUsageMetrics     Json?    @default("{}")
  isRecordingEnabled       Boolean?
  recordingKeepForDays     Int?
  isDeleted                Boolean  @default(false)
  jobs                     Job[]
  organizationCredentials  OrganizationCredentials[]

  @@index([orgStatus])
  @@index([orgCreatedAt(sort: Desc)])
}

model SuperAdmin {
  id                         String    @id @default(cuid())
  email                      String    @unique
  password                   String
  name                       String
  passwordResetOtp           String?
  passwordResetOtpExpiresAt  DateTime?
  accountCreatedAt           DateTime  @default(now())
  accountUpdatedAt           DateTime  @updatedAt
  isDeleted                  Boolean   @default(false)
}

model OrganizationCredentials {
  id                        String               @id
  email                     String               @unique
  name                      String?
  accountCreatedAt          DateTime             @default(now())
  accountUpdatedAt          DateTime             @updatedAt
  password                  String?
  platformRole              String?              @default("ADMIN")
  organizationId            String?
  passwordResetOtp          String?
  passwordResetOtpExpiresAt DateTime?
  isDeleted                 Boolean              @default(false)
  jobs                      Job[]                @relation("CreatedJobs")
  organization              OrganizationDetails? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Job {
  id                 String            @id
  title              String
  role               String?
  screeningThreshold Int               @default(0)
  creatorId          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  screeningCriteria  String?           @default("{}")
  extractedDetails   String?           @default("{}")
  interviewQuestions String?           @default("[]")
  jdFileName         String?
  jdPreviewUrl       String?
  orgId              String?
  deadline           DateTime?
  aiName             String?           @default("Ishitha")
  voiceId            String?           @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  interviewMode      String?           @default("ats")
  isDeleted          Boolean           @default(false)
  applications       Application[]
  creator            OrganizationCredentials @relation("CreatedJobs", fields: [creatorId], references: [id], onDelete: Cascade)
  organization       OrganizationDetails?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, createdAt(sort: Desc)])
}

model Application {
  id              String       @id
  fullName        String
  email           String
  phone           String
  resumeUrl       String
  aiScore         Int?
  aiReport        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  resumeText      String?
  resumeData      String?
  jobId           String
  resumeStatus    String       @default("pending")
  interviewStatus String       @default("pending")
  fullScanReport  String?
  isDeleted       Boolean      @default(false)
  fileName        String?
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  interview       Interview?

  @@index([jobId, resumeStatus, updatedAt])
  @@index([jobId, aiScore(sort: Desc), updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Interview {
  id                         String          @id
  applicationId              String          @unique
  accessToken                String          @unique @default(uuid())
  inviteSentAt               DateTime?
  expiresAt                  DateTime?
  status                     String          @default("PENDING")
  startedAt                  DateTime?
  completedAt                DateTime?
  interviewTranscript        String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  interviewDuration          Int?
  snapshots                  String[]        @default([])
  candidateFeedback          String?
  candidateRating            Json?
  billingSnapshot            Json?           @default("{}")
  integritySignals           Json?           @default("[]")
  signalAnalysis             Json?           @default("{}")
  linkStatus                 String          @default("ACTIVE")
  questionByQuestionAnalysis Json?           @default("[]")
  scoreBreakdown             Json?           @default("{}")
  interviewSummary           Json?           @default("{}")
  recording                  Json?           @default("{}")
  skillRatings               Json?           @default("[]")
  scheduledAt                DateTime?
  timezone                   String?         @default("Asia/Kolkata")
  isDeleted                  Boolean         @default(false)
  isTest                     Boolean         @default(false)
  testBillingMetrics         Json?           @default("{}")
  interviewBrief             Json?           // Pre-generated by brief-generation worker (slot flow only)
  application                Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supportTickets             SupportTicket[]

  @@index([status])
  @@index([status, completedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([isTest])
}

model SupportTicket {
  id            String     @id @default(cuid())
  interviewId   String?
  applicationId String?
  name          String
  email         String
  issueAbout    String
  status        String     @default("OPEN")
  resolvedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isDeleted     Boolean    @default(false)
  interview     Interview? @relation(fields: [interviewId], references: [id])

  @@index([status, createdAt])
  @@index([interviewId, createdAt])
  @@index([applicationId])
}

model EngineVoice {
  id          String   @id
  name        String
  provider    String
  model       String
  description String?
  gender      String?
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([isActive])
  @@index([provider])
}
