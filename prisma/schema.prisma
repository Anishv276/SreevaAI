generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String      @id
  name                 String
  slug                 String      @unique
  logoUrl              String?
  recordingEnabled     Boolean?
  recordingRetentionDays Int?
  plan                 String      @default("STARTER")
  maxActiveDrives      String      @default("Unlimited")
  proctoringSignals    Json?       @default("{\"tab_switch\":true,\"camera_disabled\":true,\"microphone_disabled\":true,\"connection_lost\":true,\"duplicate_ip\":true,\"face_absence\":true,\"multiple_faces\":true,\"identity_mismatch\":true,\"ownership_ambiguity\":true,\"example_evasion\":true,\"latency_mismatch\":true,\"resume_claim_mismatch\":true,\"ownership_clarified\":true,\"example_given\":true,\"strong_under_pressure\":true,\"follow_up_collapse\":true}")
  status               String      @default("ACTIVE")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  industry             String?
  size                 String?
  website              String?
  location             String?
  onboardingComplete   Boolean     @default(false)
  voiceId              String?     @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  allowedVoices        String[]    @default([])
  deepgramModel        String?     @default("nova-3-general")
  interviewQuotaTotal  Int         @default(0)
  interviewQuotaUsed   Int         @default(0)
  creditsUsed          Float       @default(0)
  statusControl        String      @default("QUOTA")
  usageMetrics         Json?       @default("{}")

  drives               Drive[]
  users                User[]
}

model SuperAdmin {
  id                   String              @id @default(cuid())
  email                String              @unique
  password             String
  name                 String
  resetOtp             String?
  resetOtpExpires      DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model User {
  id              String        @id
  email           String        @unique
  name            String?
  role            String        @default("CANDIDATE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  password        String?
  orgId           String?
  orgRole         String?
  phone           String?
  jobTitle        String?
  resetOtp        String?
  resetOtpExpires DateTime?
  drives          Drive[]       @relation("CreatedDrives")
  organization    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id            String       @id @default(cuid())
  interviewId   String?
  interview     Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  applicationId String?
  name          String
  email         String
  issueAbout    String
  status        String       @default("OPEN")
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([interviewId, createdAt])
}

model Drive {
  id                 String        @id
  title              String
  role               String?
  screeningThreshold Int           @default(0)
  creatorId          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  screeningCriteria  String?       @default("{}")
  extractedDetails   String?       @default("{}")
  interviewLanguage  String?       @default("English")
  interviewQuestions String?       @default("[]")
  jdFileName         String?
  jdPreviewUrl       String?
  orgId              String?
  location           String?
  deadline           DateTime?
  aiName             String?       @default("Ishitha")
  voiceId            String?       @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  applications       Application[]
  resumeCandidates   ResumeCandidate[]
  resumeBatches      ResumeBatch[]
  creator            User          @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Application {
  id               String     @id
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  aiScore          Int?
  aiReport         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  resumeText       String?
  resumeData       String?
  driveId          String
  resumeStatus     String     @default("pending")
  interviewStatus  String     @default("pending")
  hiringStatus     String     @default("pending")
  drive            Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  interview        Interview?

  @@index([driveId, resumeStatus, hiringStatus, updatedAt])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
}
model Interview {
  id                    String      @id
  applicationId         String      @unique
  accessToken           String      @unique @default(uuid())
  inviteSentAt          DateTime?
  expiresAt             DateTime?
  status                String      @default("PENDING")
  startedAt             DateTime?
  completedAt           DateTime?
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt  
  interviewDuration     Int?
  aiSummary             String?
  snapshots             String[]    @default([])
  candidateFeedback     String?
  candidateRating       Json?
  integritySignals      Json?       @default("[]")
  skillRatings          Json?       @default("{}")
  communicationScore    Int?
  cognitiveInsights     Json?       @default("{}")
  behaviorSignals       Json?       @default("{}")
  behavioralSignalsAnalysis Json?    @default("{}")
  interviewTurns        Json?       @default("[]")
  questionByQuestionAnalysis Json?  @default("[]")
  recordingStatus       String?
  recordingMimeType     String?
  recordingStartedAt    DateTime?
  recordingCompletedAt  DateTime?
  recordingDurationSec  Int?
  recordingRetentionDays Int?
  recordingRetentionDueAt DateTime?
  recordingCleanupStatus String?
  recordingCleanupAttempts Int?
  recordingCleanupLastError String?
  recordingDeletedAt    DateTime?
  recordingManifest     Json?
  billingSnapshot       Json?       @default("{}")
  linkStatus            String      @default("ACTIVE")
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supportTickets        SupportTicket[]
  @@index([updatedAt(sort: Desc)])
  @@index([status])
  @@index([recordingRetentionDueAt])
}

model ResumeCandidate {
  id              String    @id @default(cuid())
  driveId         String
  bulkBatchId     String
  fullName        String
  email           String?
  phone           String?
  fileName        String
  resumeText      String?
  aiScore         Int?
  aiReport        String?
  resumeData      String?
  resumeStatus    String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  drive           Drive     @relation(fields: [driveId], references: [id], onDelete: Cascade)
  batch           ResumeBatch @relation(fields: [bulkBatchId], references: [id], onDelete: Cascade)

  @@index([driveId, bulkBatchId])
  @@index([driveId, resumeStatus])
}

model ResumeBatch {
  id             String            @id @default(cuid())
  driveId        String
  orgId          String
  status         String            @default("PROCESSING")
  totalCount     Int               @default(0)
  processedCount Int               @default(0)
  failedCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?
  drive          Drive             @relation(fields: [driveId], references: [id], onDelete: Cascade)
  candidates     ResumeCandidate[]

  @@index([driveId, status])
}


model EngineVoice {
  id          String   @id
  name        String
  provider    String
  model       String
  description String?
  gender      String?
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([provider])
}
