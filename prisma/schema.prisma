generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  role         String        @default("CANDIDATE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  password     String?
  applications Application[]
  drives       Drive[]       @relation("CreatedDrives")
}

model Drive {
  id                   Int           @id @default(autoincrement())
  title                String
  description          String
  department           String
  location             String
  type                 String        @default("Full-time")
  status               String        @default("DRAFT")
  aiScreeningEnabled   Boolean       @default(true)
  screeningThreshold   Int           @default(60)
  creatorId            String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  aiScreeningWeights   String?       @default("{}")
  deadline             DateTime?
  positions            Int?          @default(1)
  registrationFields   String?       @default("[]")
  workMode             String?       @default("Remote")
  assessmentCount      Int           @default(5)
  assessmentDifficulty String        @default("Medium")
  assessmentTypes      String        @default("MIXED")
  proctoringEnabled    Boolean       @default(true)
  webcamMonitoring     Boolean       @default(true)
  assessmentTime       Int           @default(15)
  assessmentMode       String        @default("TEST")
  experience           String?
  responsibilities     String?
  salary               String?
  skills               String?
  extractedDetails     String?       @default("{}")
  applications         Application[]
  creator              User          @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
}

model Application {
  id               String      @id @default(cuid())
  status           String      @default("APPLIED")
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  aiScore          Int?
  aiReport         String?
  driveId          Int
  userId           String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  resumeText       String?
  experienceYears  Float?
  relevantYears    Float?
  structuredResume String?     @default("{}")
  submissionData   Json?       @default("{}")
  location         String?
  drive            Drive       @relation(fields: [driveId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id])
  assessment       Assessment?
  interview        Interview?
}

model Interview {
  id                    String      @id @default(cuid())
  applicationId         String      @unique
  accessToken           String      @unique @default(uuid())
  expiresAt             DateTime?
  status                String      @default("PENDING")
  startedAt             DateTime?
  completedAt           DateTime?
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  interviewDuration     Int?
  aiSummary             String?
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Assessment {
  id                    String               @id @default(cuid())
  applicationId         String               @unique
  startedAt             DateTime?
  completedAt           DateTime?
  score                 Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  suspiciousFlags       String?              @default("[]")
  tabSwitchCount        Int                  @default(0)
  aiReport              String?
  accessToken           String               @unique @default(uuid())
  expiresAt             DateTime?
  status                String               @default("PENDING")
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  interviewDuration     Int?
  application           Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questions             AssessmentQuestion[]
  responses             AssessmentResponse[]
  events                ProctoringEvent[]
}

model ProctoringEvent {
  id              String     @id @default(cuid())
  assessmentId    String
  eventType       String
  severity        String     @default("MEDIUM")
  reason          String?
  timestamp       DateTime   @default(now())
  durationSeconds Int?
  metadata        String?    @default("{}")
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentQuestion {
  id            String     @id @default(cuid())
  assessmentId  String
  text          String
  type          String
  options       String?
  correctAnswer String?
  order         Int        @default(0)
  starterCode   String?
  testCases     String?
  intent        String?
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentResponse {
  id           String     @id @default(cuid())
  assessmentId String
  questionId   String
  answer       String
  isCorrect    Boolean?
  aiFeedback   String?
  createdAt    DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}
