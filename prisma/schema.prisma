generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                     String   @id
  name                   String
  slug                   String   @unique
  logoUrl                String?
  plan                   String   @default("STARTER")
  maxActiveDrives        String   @default("Unlimited")
  proctoringSignals      Json?    @default("{\"tab_switch\": false, \"face_absence\": false, \"multiple_faces\": false, \"camera_disabled\": false, \"connection_lost\": false, \"latency_mismatch\": false, \"identity_mismatch\": false, \"microphone_disabled\": false, \"complexity_latency_mismatch\": false}")
  status                 String   @default("ACTIVE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  website                String?
  onboardingComplete     Boolean  @default(false)
  voiceId                String?  @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  allowedVoices          String[] @default([])
  deepgramModel          String?  @default("flux-general-en")
  interviewQuotaTotal    Int      @default(0)
  interviewQuotaUsed     Int      @default(0)
  creditsUsed            Float    @default(0)
  statusControl          String   @default("QUOTA")
  usageMetrics           Json?    @default("{}")
  recordingEnabled       Boolean?
  recordingRetentionDays Int?
  isDeleted              Boolean  @default(false)
  drives                 Drive[]
  users                  User[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model SuperAdmin {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String
  resetOtp        String?
  resetOtpExpires DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean   @default(false)
}

model User {
  id              String        @id
  email           String        @unique
  name            String?
  role            String        @default("CANDIDATE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  password        String?
  orgId           String?
  orgRole         String?
  resetOtp        String?
  resetOtpExpires DateTime?
  isDeleted       Boolean       @default(false)
  drives          Drive[]       @relation("CreatedDrives")
  organization    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Drive {
  id                 String            @id
  title              String
  role               String?
  screeningThreshold Int               @default(0)
  creatorId          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  screeningCriteria  String?           @default("{}")
  extractedDetails   String?           @default("{}")
  interviewLanguage  String?           @default("English")
  interviewQuestions String?           @default("[]")
  jdFileName         String?
  jdPreviewUrl       String?
  orgId              String?
  location           String?
  deadline           DateTime?
  aiName             String?           @default("Ishitha")
  voiceId            String?           @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  isDeleted          Boolean           @default(false)
  applications       Application[]
  creator            User              @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
  organization       Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resumeBatches      ResumeBatch[]

  @@index([orgId])
  @@index([orgId, createdAt(sort: Desc)])
}

model Application {
  id              String       @id
  fullName        String
  email           String
  phone           String
  resumeUrl       String
  aiScore         Int?
  aiReport        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  resumeText      String?
  resumeData      String?
  driveId         String
  resumeStatus    String       @default("pending")
  interviewStatus String       @default("pending")
  hiringStatus    String       @default("pending")
  fullScanReport  String?
  isDeleted       Boolean      @default(false)
  bulkBatchId     String?
  fileName        String?
  drive           Drive        @relation(fields: [driveId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  interview       Interview?
  resumeBatch     ResumeBatch? @relation(fields: [bulkBatchId], references: [id], onDelete: SetNull)

  @@index([driveId, resumeStatus, hiringStatus, updatedAt])
  @@index([driveId, aiScore(sort: Desc), updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([bulkBatchId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Interview {
  id                         String          @id
  applicationId              String          @unique
  accessToken                String          @unique @default(uuid())
  inviteSentAt               DateTime?
  expiresAt                  DateTime?
  status                     String          @default("PENDING")
  startedAt                  DateTime?
  completedAt                DateTime?
  interviewTranscript        String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  interviewDuration          Int?
  snapshots                  String[]        @default([])
  candidateFeedback          String?
  candidateRating            Json?
  billingSnapshot            Json?           @default("{}")
  integritySignals           Json?           @default("[]")
  signalAnalysis             Json?           @default("{}")
  linkStatus                 String          @default("ACTIVE")
  questionByQuestionAnalysis Json?           @default("[]")
  scoreBreakdown             Json?           @default("{}")
  interviewSummary           Json?           @default("{}")
  recording                  Json?           @default("{}")
  skillRatings               Json?           @default("[]")
  isDeleted                  Boolean         @default(false)
  application                Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supportTickets             SupportTicket[]

  @@index([status])
  @@index([status, completedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
}

model SupportTicket {
  id            String     @id @default(cuid())
  interviewId   String?
  applicationId String?
  name          String
  email         String
  issueAbout    String
  status        String     @default("OPEN")
  resolvedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isDeleted     Boolean    @default(false)
  interview     Interview? @relation(fields: [interviewId], references: [id])

  @@index([status, createdAt])
  @@index([interviewId, createdAt])
  @@index([applicationId])
}

model ResumeBatch {
  id             String        @id @default(cuid())
  driveId        String
  orgId          String
  status         String        @default("PROCESSING")
  totalCount     Int           @default(0)
  processedCount Int           @default(0)
  failedCount    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?
  isDeleted      Boolean       @default(false)
  drive          Drive         @relation(fields: [driveId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@index([driveId, status])
}

model EngineVoice {
  id          String   @id
  name        String
  provider    String
  model       String
  description String?
  gender      String?
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([isActive])
  @@index([provider])
}
