generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String      @id
  name                 String
  slug                 String      @unique
  logoUrl              String?
  plan                 String      @default("STARTER")
  maxActiveDrives      Int         @default(0)
  maxTeamMembers       Int         @default(0)
  proctoringSignals    Json?       @default("{\"tab_switch\":true,\"fullscreen_exit\":true,\"camera_disabled\":true,\"microphone_disabled\":true,\"connection_lost\":true,\"connection_restored\":true,\"audio_flag\":true,\"duplicate_ip\":true,\"face_absence\":true,\"multiple_faces\":true,\"gaze_violation\":true,\"head_pose_violation\":true,\"identity_mismatch\":true,\"ownership_ambiguity\":true,\"example_evasion\":true,\"latency_mismatch\":true,\"resume_claim_mismatch\":true,\"ownership_clarified\":true,\"example_given\":true,\"strong_under_pressure\":true,\"follow_up_collapse\":true,\"contradiction\":true,\"contradiction_resolved\":true,\"meta_question\":true}")
  status               String      @default("ACTIVE")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  industry             String?
  size                 String?
  website              String?
  location             String?
  onboardingComplete   Boolean     @default(false)
  ttsProvider          String?     @default("CARTESIA")
  cartesiaVoiceId      String?     @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  sarvamModel          String?     @default("bulbul:v3")
  sarvamVoice          String?     @default("shubh")
  googleModel          String?     @default("gemini-3.1-flash-tts-preview")
  googleVoiceName      String?     @default("Puck")
  deepgramModel        String?     @default("nova-3-general")
  sarvamSttModel       String?     @default("saaras:v3")
  sttProvider          String?     @default("DEEPGRAM")
  llmModel             String?     @default("gpt-4o")
  llmProvider          String?     @default("OPENAI")
  llmTemperature       Float?      @default(0.7)
  cartesiaModel        String?     @default("cartesia/sonic-3")
  creditsTotal         Float       @default(0)
  creditsUsed          Float       @default(0)
  usageMetrics         Json?       @default("{}")
  googleAccessToken    String?
  googleEmail          String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  customDomain         String?
  drives               Drive[]
  invites              OrgInvite[]
  users                User[]
}

model SuperAdmin {
  id                   String              @id @default(cuid())
  email                String              @unique
  password             String
  name                 String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  googleAccessToken    String?
  googleEmail          String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  customDomain         String?
  verificationTokens   VerificationToken[]
}

model User {
  id              String        @id
  email           String        @unique
  name            String?
  role            String        @default("CANDIDATE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  password        String?
  orgId           String?
  orgRole         String?
  phone           String?
  jobTitle        String?
  resetOtp        String?
  resetOtpExpires DateTime?
  applications    Application[]
  drives          Drive[]       @relation("CreatedDrives")
  acceptedInvites OrgInvite[]   @relation("AcceptedInvites")
  sentInvites     OrgInvite[]   @relation("SentInvites")
  organization    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model OrgInvite {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String
  email           String
  orgRole         String
  tokenHash       String       @unique
  status          String       @default("PENDING")
  invitedByUserId String
  acceptedUserId  String?
  expiresAt       DateTime
  respondedAt     DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  acceptedUser    User?        @relation("AcceptedInvites", fields: [acceptedUserId], references: [id])
  invitedByUser   User         @relation("SentInvites", fields: [invitedByUserId], references: [id])
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model SupportTicket {
  id            String       @id @default(cuid())
  interviewId   String?
  interview     Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  applicationId String?
  name          String
  email         String
  issueAbout    String
  status        String       @default("OPEN")
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([interviewId, createdAt])
}

model Drive {
  title              String
  role               String?
  description        String
  department         String
  type               String        @default("Full-time")
  screeningThreshold Int           @default(60)
  creatorId          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deadline           DateTime?
  positions          Int?          @default(1)
  registrationFields String?       @default("[]")
  workMode           String?
  experience         String?
  responsibilities   String?
  requirements       String?
  salary             String?
  skills             String?
  extractedDetails   String?       @default("{}")
  interviewLanguage  String?       @default("English")
  interviewTime      Int?
  proctoringLevel    String?       @default("Medium")
  interviewQuestions String?       @default("[]")
  jdFileName         String?
  jdPreviewUrl       String?
  orgId              String?
  status             String        @default("ACTIVE")
  isPassportRequired Boolean       @default(false)
  slug               String?       @unique
  id                 String        @id
  shortlistMode      String        @default("automatic")
  location           String?
  aiName             String?       @default("Ishitha")
  cartesiaVoiceId    String?       @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  sarvamVoice        String?       @default("shubh")
  sarvamModel        String?       @default("bulbul:v3")
  googleModel        String?       @default("gemini-3.1-flash-tts-preview")
  googleVoiceName    String?       @default("Puck")
  ttsProvider        String?       @default("CARTESIA")
  applications       Application[]
  creator            User          @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([slug])
}

model Application {
  id               String     @id
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  aiScore          Int?
  aiReport         String?
  userId           String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  resumeText       String?
  experienceYears  Float?
  structuredResume String?    @default("{}")
  submissionData   Json?      @default("{}")
  passportUrl      String?
  driveId          String
  resumeStatus     String     @default("pending")
  interviewStatus  String     @default("pending")
  hiringStatus     String     @default("pending")
  drive            Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User?      @relation(fields: [userId], references: [id])
  interview        Interview?

  @@index([driveId, resumeStatus, hiringStatus, updatedAt])
}

model Interview {
  id                    String      @id
  applicationId         String      @unique
  accessToken           String      @unique @default(uuid())
  expiresAt             DateTime?
  status                String      @default("PENDING")
  startedAt             DateTime?
  completedAt           DateTime?
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  interviewDuration     Int?
  aiSummary             String?
  snapshots             String[]    @default([])
  candidateFeedback     String?
  candidateRating       Int?
  proctoringEvents      Json?       @default("[]")
  interviewReport       Json?       @default("{}")
  proctoringReport      Json?       @default("{}")
  strategicVerdict      Json?       @default("{}")
  interviewTurns        Json?       @default("[]")
  answerScores          Json?       @default("{}")
  recordingStatus       String?     @default("NOT_STARTED")
  recordingMimeType     String?
  recordingStartedAt    DateTime?
  recordingCompletedAt  DateTime?
  recordingDurationSec  Int?
  recordingManifest     Json?       @default("{}")
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supportTickets        SupportTicket[]
}

model VerificationToken {
  id           String      @id @default(cuid())
  token        String
  expires      DateTime
  createdAt    DateTime    @default(now())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([token, superAdminId])
}

model ProcessedWebhook {
  id          String   @id
  processedAt DateTime @default(now())
}
