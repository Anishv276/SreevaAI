generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String      @id
  name                 String
  slug                 String      @unique
  logoUrl              String?
  plan                 String      @default("STARTER")
  maxActiveDrives      String      @default("Unlimited")
  proctoringSignals    Json?       @default("{\"tab_switch\":true,\"camera_disabled\":true,\"microphone_disabled\":true,\"connection_lost\":true,\"duplicate_ip\":true,\"face_absence\":true,\"multiple_faces\":true,\"identity_mismatch\":true,\"ownership_ambiguity\":true,\"example_evasion\":true,\"latency_mismatch\":true,\"resume_claim_mismatch\":true,\"ownership_clarified\":true,\"example_given\":true,\"strong_under_pressure\":true,\"follow_up_collapse\":true,\"contradiction\":true,\"contradiction_resolved\":true}")
  status               String      @default("ACTIVE")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  industry             String?
  size                 String?
  website              String?
  location             String?
  onboardingComplete   Boolean     @default(false)
  ttsProvider          String?     @default("CARTESIA")
  cartesiaVoiceId      String?     @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  sarvamModel          String?     @default("bulbul:v3")
  sarvamVoice          String?     @default("shubh")
  googleModel          String?     @default("gemini-3.1-flash-tts-preview")
  googleVoiceName      String?     @default("Puck")
  deepgramModel        String?     @default("nova-3-general")
  sarvamSttModel       String?     @default("saaras:v3")
  sttProvider          String?     @default("DEEPGRAM")
  llmModel             String?     @default("gpt-4o")
  llmProvider          String?     @default("OPENAI")
  llmTemperature       Float?      @default(0.7)
  cartesiaModel        String?     @default("cartesia/sonic-3")
  interviewQuotaTotal  Int         @default(0)
  interviewQuotaUsed   Int         @default(0)
  creditsUsed          Float       @default(0)
  statusControl        String      @default("QUOTA")
  usageMetrics         Json?       @default("{}")
  drives               Drive[]
  users                User[]
  interviewSlots       InterviewSlot[]
}

model SuperAdmin {
  id                   String              @id @default(cuid())
  email                String              @unique
  password             String
  name                 String
  resetOtp             String?
  resetOtpExpires      DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model User {
  id              String        @id
  email           String        @unique
  name            String?
  role            String        @default("CANDIDATE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  password        String?
  orgId           String?
  orgRole         String?
  phone           String?
  jobTitle        String?
  resetOtp        String?
  resetOtpExpires DateTime?
  applications    Application[]
  drives          Drive[]       @relation("CreatedDrives")
  organization    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id            String       @id @default(cuid())
  interviewId   String?
  interview     Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  applicationId String?
  name          String
  email         String
  issueAbout    String
  status        String       @default("OPEN")
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([interviewId, createdAt])
}

model Drive {
  id                 String        @id
  title              String
  role               String?
  description        String
  department         String
  type               String        @default("Full-time")
  screeningThreshold Int           @default(0)
  inviteScheduleDays Int           @default(1)
  creatorId          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  positions          Int?          @default(1)
  workMode           String?
  experience         String?
  responsibilities   String?
  requirements       String?
  salary             String?
  skills             String?
  screeningCriteria  String?       @default("{}")
  extractedDetails   String?       @default("{}")
  interviewLanguage  String?       @default("English")
  interviewQuestions String?       @default("[]")
  jdFileName         String?
  jdPreviewUrl       String?
  orgId              String?
  location           String?
  status             String        @default("ACTIVE")
  aiName             String?       @default("Ishitha")
  cartesiaVoiceId    String?       @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  sarvamVoice        String?       @default("shubh")
  sarvamModel        String?        @default("bulbul:v3")
  googleModel        String?       @default("gemini-3.1-flash-tts-preview")
  googleVoiceName    String?       @default("Puck")
  ttsProvider        String?       @default("CARTESIA")
  applications       Application[]
  resumeCandidates   ResumeCandidate[]
  resumeBatches      ResumeBatch[]
  interviewSlots     InterviewSlot[]
  creator            User          @relation("CreatedDrives", fields: [creatorId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model Application {
  id               String     @id
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  aiScore          Int?
  aiReport         String?
  userId           String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  resumeText       String?
  resumeData       String?
  driveId          String
  resumeStatus     String     @default("pending")
  interviewStatus  String     @default("pending")
  hiringStatus     String     @default("pending")
  drive            Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User?      @relation(fields: [userId], references: [id])
  interview        Interview?

  @@index([driveId, resumeStatus, hiringStatus, updatedAt])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
}

model Interview {
  id                    String      @id
  applicationId         String      @unique
  accessToken           String      @unique @default(uuid())
  scheduledAt           DateTime?
  inviteSentAt          DateTime?
  expiresAt             DateTime?
  status                String      @default("PENDING")
  startedAt             DateTime?
  completedAt           DateTime?
  interviewRecordingUrl String?
  interviewTranscript   String?
  interviewRecordedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  interviewDuration     Int?
  aiSummary             String?
  snapshots             String[]    @default([])
  candidateFeedback     String?
  candidateRating       Int?
  proctoringEvents      Json?       @default("[]")
  interviewReport       Json?       @default("{}")
  proctoringReport      Json?       @default("{}")
  strategicVerdict      Json?       @default("{}")
  interviewTurns        Json?       @default("[]")
  answerScores          Json?       @default("{}")
  recordingStatus       String?     @default("NOT_STARTED")
  recordingMimeType     String?
  recordingStartedAt    DateTime?
  recordingCompletedAt  DateTime?
  recordingDurationSec  Int?
  recordingManifest     Json?       @default("{}")
  billingSnapshot       Json?       @default("{}")
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supportTickets        SupportTicket[]
  slotId                String?
  slot                  InterviewSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([updatedAt(sort: Desc)])
  @@index([status])
}

model ResumeCandidate {
  id              String    @id @default(cuid())
  driveId         String
  bulkBatchId     String
  fullName        String
  email           String?
  phone           String?
  fileName        String
  resumeText      String?
  aiScore         Int?
  aiReport        String?
  resumeData      String?
  resumeStatus    String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  drive           Drive     @relation(fields: [driveId], references: [id], onDelete: Cascade)
  batch           ResumeBatch @relation(fields: [bulkBatchId], references: [id], onDelete: Cascade)

  @@index([driveId, bulkBatchId])
  @@index([driveId, resumeStatus])
}

model ResumeBatch {
  id             String            @id @default(cuid())
  driveId        String
  orgId          String
  status         String            @default("PROCESSING")
  totalCount     Int               @default(0)
  processedCount Int               @default(0)
  failedCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?
  drive          Drive             @relation(fields: [driveId], references: [id], onDelete: Cascade)
  candidates     ResumeCandidate[]

  @@index([driveId, status])
}

model InterviewSlot {
  id          String      @id @default(cuid())
  orgId       String
  driveId     String
  startTime   DateTime
  endTime     DateTime
  maxCapacity Int         @default(5)
  bookedCount Int         @default(0)
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  drive        Drive        @relation(fields: [driveId], references: [id], onDelete: Cascade)
  interviews   Interview[]
  
  @@index([orgId, startTime])
  @@index([driveId, startTime])
}
