generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OrganizationDetails {
  id                       String                    @id
  name                     String
  urlSlug                  String                    @unique
  billingPlan              String                    @default("STARTER")
  maxActiveJobs            String                    @default("Unlimited")
  maxConcurrentInterviews  Int                       @default(5)
  enabledProctoringSignals Json?                     @default("{\"tab_switch\": false, \"fullscreen_exit\": false, \"window_focus_loss\": false, \"face_absence\": false, \"multiple_faces\": false, \"camera_disabled\": false, \"connection_lost\": false, \"latency_mismatch\": false, \"identity_mismatch\": false, \"microphone_disabled\": false, \"answer_integrity\": false, \"session_fingerprint\": false}")
  orgStatus                String                    @default("ACTIVE")
  orgCreatedAt             DateTime                  @default(now())
  orgUpdatedAt             DateTime                  @updatedAt
  isOnboardingComplete     Boolean                   @default(false)
  // AI Model Configuration (all set via Super Admin → Models page)
  sttModel                 String                    @default("flux-general-en")
  ttsProvider              String                    @default("ELEVENLABS")
  ttsModel                 String                    @default("eleven_turbo_v2_5")
  ttsSpeed                 Float                     @default(1)
  defaultVoiceId           String                    @default("EXAVITQu4vr4xnSDxMaL")
  allowedVoiceIds          String[]                  @default([])
  llmResumeExtraction      String                    @default("gpt-5.4-mini")
  llmJdExtraction          String                    @default("gpt-5.4-mini")
  llmResumeReport          String                    @default("gpt-5.4-mini")
  llmInterviewLive         String                    @default("gpt-4.1-mini")
  llmInterviewEval         String                    @default("gpt-4.1-nano")
  llmInterviewBrief        String                    @default("gpt-4.1")
  llmInterviewReport       String                    @default("gpt-5.4-mini")
  totalInterviewsAllowed   Int                       @default(0)
  totalInterviewsUsed      Int                       @default(0)
  billingCreditsUsed       Float                     @default(0)
  quotaControlMode         String                    @default("QUOTA")
  // Subscription display fields (maintained manually by super admin; no payment automation)
  planPriceUsd             Float?
  billingCycle             String? // "Monthly" | "Yearly"
  nextBillingDate          DateTime?
  isRecordingEnabled       Boolean?
  recordingKeepForDays     Int?
  isDeleted                Boolean                   @default(false)
  jobs                     Job[]
  organizationCredentials  OrganizationCredentials[]
  usageEvents              UsageEvent[]

  @@index([orgStatus])
  @@index([orgCreatedAt(sort: Desc)])
}

model SuperAdmin {
  id                        String    @id @default(cuid())
  email                     String    @unique
  password                  String
  name                      String
  passwordResetOtp          String?
  passwordResetOtpExpiresAt DateTime?
  accountCreatedAt          DateTime  @default(now())
  accountUpdatedAt          DateTime  @updatedAt
  isDeleted                 Boolean   @default(false)
}

// Singleton row (id always "singleton") holding platform-wide settings
// that aren't tied to a specific org or admin, e.g. the /test sandbox access key.
model AppSettings {
  id                        String    @id @default("singleton")
  testAccessKey             String?
  testAccessKeyOtp          String?
  testAccessKeyOtpExpiresAt DateTime?
  updatedAt                 DateTime  @updatedAt
}

model OrganizationCredentials {
  id                        String               @id
  email                     String               @unique
  name                      String?
  accountCreatedAt          DateTime             @default(now())
  accountUpdatedAt          DateTime             @updatedAt
  password                  String?
  platformRole              String?              @default("ADMIN")
  organizationId            String?
  passwordResetOtp          String?
  passwordResetOtpExpiresAt DateTime?
  isDeleted                 Boolean              @default(false)
  jobs                      Job[]                @relation("CreatedJobs")
  organization              OrganizationDetails? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Job {
  id                            String                  @id
  title                         String
  jobRole                       String?
  resumeScreeningThreshold      Int                     @default(0)
  createdByCredentialId         String
  jobCreatedAt                  DateTime                @default(now())
  jobUpdatedAt                  DateTime                @updatedAt
  resumeScreeningCriteria       String?                 @default("{}")
  jdExtractedDetails            String?                 @default("{}")
  aiGeneratedInterviewQuestions String?                 @default("[]")
  jdFileName                    String?
  jdPreviewUrl                  String?
  organizationId                String?
  applicationDeadline           DateTime?
  aiInterviewerName             String?                 @default("Ishitha")
  aiInterviewerVoiceId          String?                 @default("9626c31c-bec5-4cca-baa8-f8ba9e84c8bc")
  interviewMode                 String?                 @default("ats")
  interviewType                 String?                 @default("tech")
  isDeleted                     Boolean                 @default(false)
  applications                  Application[]
  creator                       OrganizationCredentials @relation("CreatedJobs", fields: [createdByCredentialId], references: [id], onDelete: Cascade)
  organization                  OrganizationDetails?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, jobCreatedAt(sort: Desc)])
}

model Application {
  id                    String     @id
  candidateFullName     String
  candidateEmail        String
  candidatePhone        String
  resumeFileUrl         String
  resumeAiScore         Int?
  resumeAiReport        String?
  appliedAt             DateTime   @default(now())
  applicationUpdatedAt  DateTime   @updatedAt
  resumeRawText         String?
  resumeParsedData      String?
  jobId                 String
  resumeScreeningStatus String     @default("pending")
  interviewPhaseStatus  String     @default("pending")
  resumeFullScanReport  String?
  isDeleted             Boolean    @default(false)
  resumeFileName        String?
  job                   Job        @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  interview             Interview?

  @@index([jobId, resumeScreeningStatus, applicationUpdatedAt])
  @@index([jobId, resumeAiScore(sort: Desc), applicationUpdatedAt(sort: Desc)])
  @@index([appliedAt(sort: Desc)])
  @@index([applicationUpdatedAt(sort: Desc)])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Interview {
  id                          String          @id
  applicationId               String          @unique
  candidateInviteToken        String          @unique @default(uuid())
  inviteEmailSentAt           DateTime?
  inviteLinkExpiresAt         DateTime?
  interviewStatus             String          @default("PENDING")
  interviewStartedAt          DateTime?
  interviewCompletedAt        DateTime?
  fullTranscript              String?
  interviewCreatedAt          DateTime        @default(now())
  interviewUpdatedAt          DateTime        @updatedAt
  durationInSeconds           Int?
  proctoringSnapshotUrls      String[]        @default([])
  candidateFeedbackText       String?
  candidateSelfRating         Json?
  // Atomic idempotency claim for interview-quota deduction (billing.py's
  // deduct_quota). NULL = not yet deducted; set once via a single
  // UPDATE ... WHERE "quotaDeductedAt" IS NULL RETURNING id.
  quotaDeductedAt             DateTime?
  proctoringEvents            Json?           @default("[]")
  proctoringAnalysis          Json?           @default("{}")
  perQuestionAnalysis         Json?           @default("[]")
  aiScoreBreakdown            Json?           @default("{}")
  aiInterviewSummary          Json?           @default("{}")
  sessionRecording            Json?           @default("{}")
  aiSkillRatings              Json?           @default("[]")
  interviewScheduledAt        DateTime?
  interviewTimezone           String?         @default("Asia/Kolkata")
  isDeleted                   Boolean         @default(false)
  isTestSession               Boolean         @default(false)
  aiInterviewBrief            Json? // Pre-generated by brief-generation worker (slot flow only)
  application                 Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supportTickets              SupportTicket[]

  @@index([interviewStatus])
  @@index([interviewStatus, interviewCompletedAt(sort: Desc)])
  @@index([interviewStatus, interviewUpdatedAt(sort: Desc)])
  @@index([interviewUpdatedAt(sort: Desc)])
  @@index([isTestSession])
}

model SupportTicket {
  id               String     @id @default(cuid())
  interviewId      String?
  applicationId    String?
  reporterName     String
  reporterEmail    String
  issueDescription String
  ticketStatus     String     @default("OPEN")
  ticketResolvedAt DateTime?
  ticketCreatedAt  DateTime   @default(now())
  ticketUpdatedAt  DateTime   @updatedAt
  isDeleted        Boolean    @default(false)
  interview        Interview? @relation(fields: [interviewId], references: [id])

  @@index([ticketStatus, ticketCreatedAt])
  @@index([interviewId, ticketCreatedAt])
  @@index([applicationId])
}

// Entity-level billing ledger. ONE row per (organizationId, feature, entity) —
// jd:{jobId}, resume:{applicationId}, interview:{applicationId}. Upserted (NOT
// append-only) as calls accumulate: the `usage` JSON holds the per-sub-feature,
// per-model breakdown and `costUsd` is the running sum of every costUsd inside
// it. This table is the SOLE source of truth for all cost totals, real
// (isTest=false) and test (isTest=true). Rows are upserted by billing.py's
// ledger classes (JdExtractionLedger / ResumeLedger / InterviewLedger).
//
// usage JSON shape (keys present depend on feature):
//   jdExtraction:     { jdExtraction: { llm: [ {model, provider, calls, inputTokens,
//                        cachedInputTokens, outputTokens, costUsd}, ... ] } }
//   resume:           { resumeExtraction: { llm: [...] }, resumeReport: { llm: [...] } }
//   interview:        { eval|brief|llmGeneration|report: { llm: [...] },
//                        tts: { characters, costUsd, byModel: [...] },
//                        stt: { seconds, costUsd, byModel: [...] } }
model UsageEvent {
  id             String              @id @default(cuid())
  organizationId String
  feature        String // jdExtraction | resumeExtraction | interview
  jobId          String? // Prisma Job id (JD extraction) or the resume/interview job's id
  applicationId  String?
  interviewId    String?
  jobTitle       String? // denormalized at write time — survives deletion
  candidateName  String? // denormalized at write time
  isTest         Boolean             @default(false)
  usage          Json                @default("{}") // per-sub-feature / per-model breakdown
  costUsd        Float               @default(0) // running total = sum of every costUsd in usage
  eventId        String              @unique // entity key: jd:{jobId} | resume:{appId} | interview:{appId}
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   OrganizationDetails @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, feature, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([applicationId])
}

// Materialized per-org cost summary, one row per org, one column per billing
// feature. Recomputed by summing the UsageEvent ledger (isTest=false) via
// lib/usage-metrics.ts#refreshOrgUsageSummary -- never
// written to directly by request handlers, so it can't drift out of sync with
// the live usage view. Exists for fast cross-org reporting/export without
// recomputing from JSON blobs on every query.
model OrgUsageSummary {
  orgId                     String   @id
  orgName                   String
  jdExtractionCostUsd       Float    @default(0)
  resumeExtractionCostUsd   Float    @default(0)
  resumeReportCostUsd       Float    @default(0)
  interviewLlmCostUsd       Float    @default(0)
  interviewEvalCostUsd      Float    @default(0)
  interviewBriefCostUsd     Float    @default(0)
  interviewGenerationCostUsd Float   @default(0)
  interviewTtsCostUsd       Float    @default(0)
  interviewSttCostUsd       Float    @default(0)
  interviewReportCostUsd    Float    @default(0)
  totalCostUsd              Float    @default(0)
  lastComputedAt            DateTime @default(now()) @updatedAt
}

model AIVoice {
  id               String   @id
  voiceName        String
  voiceProvider    String
  voiceModel       String
  voiceDescription String?
  voiceGender      String?
  voiceTags        String[] @default([])
  isAvailable      Boolean  @default(true)
  isSystemDefault  Boolean  @default(false)
  voiceCreatedAt   DateTime @default(now())
  voiceUpdatedAt   DateTime @updatedAt
  isDeleted        Boolean  @default(false)

  @@index([isAvailable])
  @@index([voiceProvider])
}
