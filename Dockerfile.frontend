# --- Stage 1: Build ---
FROM node:20-slim AS builder
WORKDIR /app

# Install dependencies and openssl
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
COPY scripts ./scripts
RUN npm install

# Copy source code
COPY . .

# Pass build-time environment variables (required for Next.js NEXT_PUBLIC_ vars)
ARG NEXT_PUBLIC_LIVEKIT_URL
ARG NEXT_PUBLIC_APP_URL
ARG DATABASE_URL="postgresql://dummy:dummy@localhost/dummy"
ARG DIRECT_URL="postgresql://dummy:dummy@localhost/dummy"

ENV NEXT_PUBLIC_LIVEKIT_URL=$NEXT_PUBLIC_LIVEKIT_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV DATABASE_URL=$DATABASE_URL
ENV DIRECT_URL=$DIRECT_URL

# Generate Prisma Client
RUN npx prisma generate

# Build the Next.js application
RUN npm run build

# --- Stage 2: Production ---
FROM node:20-slim AS runner
WORKDIR /app

# Install openssl and python in runner
RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    ffmpeg \
    python3 \
    python3-pip \
    python3-venv \
    tesseract-ocr \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies for resume extraction
RUN pip3 install --no-cache-dir --break-system-packages \
    pymupdf4llm \
    pdfplumber \
    pytesseract \
    pdf2image \
    Pillow \
    openai \
    python-dotenv \
    pydantic \
    fastapi \
    uvicorn \
    python-multipart

# Set to production
ENV NODE_ENV=production

# Copy necessary files from builder
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/extraction_resume_JD_score_report ./extraction_resume_JD_score_report
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder /app/worker.ts ./worker.ts
COPY --from=builder /app/tsconfig.json ./tsconfig.json

EXPOSE 3000

# Start the application
CMD ["npm", "start"]
