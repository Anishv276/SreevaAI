# --- Stage 1: Build ---
FROM node:20-slim AS builder
WORKDIR /app

# Install dependencies and openssl
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
COPY scripts ./scripts
RUN npm install

# Copy source code
COPY . .

# Pass build-time environment variables (required for Next.js NEXT_PUBLIC_ vars)
ARG NEXT_PUBLIC_LIVEKIT_URL
ARG NEXT_PUBLIC_APP_URL
ARG DATABASE_URL="postgresql://dummy:dummy@localhost/dummy"
ARG DIRECT_URL="postgresql://dummy:dummy@localhost/dummy"

ENV NEXT_PUBLIC_LIVEKIT_URL=$NEXT_PUBLIC_LIVEKIT_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV DATABASE_URL=$DATABASE_URL
ENV DIRECT_URL=$DIRECT_URL

# Generate Prisma Client
RUN npx prisma generate

# Build the Next.js application
RUN npm run build

# --- Stage 2: Production ---
FROM node:20-slim AS runner
WORKDIR /app

# Install openssl and python in runner
RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies for resume/JD extraction + billing subprocess.
# Reuses livekit-python-agent's requirements.txt (superset) instead of a
# separate trimmed list -- one file to keep in sync, not two.
COPY livekit-python-agent/requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Set to production
ENV NODE_ENV=production

# Copy necessary files from builder
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/extraction_resume_JD_score_report ./extraction_resume_JD_score_report
COPY --from=builder /app/livekit-python-agent/billing ./billing
# billing.py imports from interview.agent_runtime_support / interview.agent_utils --
# both lightweight (dotenv + pydantic only), no heavy livekit-agents/asyncpg deps pulled in.
COPY --from=builder /app/livekit-python-agent/interview ./interview
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/certs ./certs
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder /app/worker.ts ./worker.ts
COPY --from=builder /app/tsconfig.json ./tsconfig.json
COPY --from=builder /app/next.config.ts ./next.config.ts
COPY --from=builder /app/instrumentation.ts ./instrumentation.ts

# Run as a non-root user -- code execution inside the container should not
# equal root on the container (and by extension, root-equivalent capabilities
# against anything the container can reach).
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs nextjs \
    && chown -R nextjs:nodejs /app
USER nextjs

EXPOSE 3000

# Apply any pending migrations against the real DB, then start.
# migrate deploy only runs already-committed migration files (prisma/migrations/) --
# never db push in prod, and never migrate dev (that can prompt/reset).
CMD ["sh", "-c", "npx prisma migrate deploy && npm start"]
