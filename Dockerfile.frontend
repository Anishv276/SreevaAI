# --- Stage 1: Build ---
FROM node:20-slim AS builder
WORKDIR /app

# Install dependencies and openssl
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
COPY scripts ./scripts
RUN npm install

# Copy source code
COPY . .

# Pass build-time environment variables (required for Next.js NEXT_PUBLIC_ vars)
ARG NEXT_PUBLIC_LIVEKIT_URL
ARG NEXT_PUBLIC_APP_URL
ARG DATABASE_URL="postgresql://dummy:dummy@localhost/dummy"
ARG DIRECT_URL="postgresql://dummy:dummy@localhost/dummy"

ENV NEXT_PUBLIC_LIVEKIT_URL=$NEXT_PUBLIC_LIVEKIT_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV DATABASE_URL=$DATABASE_URL
ENV DIRECT_URL=$DIRECT_URL

# Generate Prisma Client
RUN npx prisma generate

# Build the Next.js application
RUN npm run build

# --- Stage 2: Production ---
FROM node:20-slim AS runner
WORKDIR /app

# Install openssl and python in runner
RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies for resume/JD extraction + billing subprocess.
# Reuses livekit-python-agent's requirements.txt (superset) instead of a
# separate trimmed list -- one file to keep in sync, not two.
COPY livekit-python-agent/requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Set to production
ENV NODE_ENV=production

# Run as a non-root user -- code execution inside the container should not
# equal root on the container (and by extension, root-equivalent capabilities
# against anything the container can reach). Created before the COPYs below so
# each COPY --chown= assigns ownership inline instead of a separate `chown -R`
# pass over node_modules afterward (that recursive walk was the slow step).
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs nextjs

# Copy necessary files from builder
COPY --chown=nextjs:nodejs --from=builder /app/public ./public
COPY --chown=nextjs:nodejs --from=builder /app/.next ./.next
COPY --chown=nextjs:nodejs --from=builder /app/node_modules ./node_modules
COPY --chown=nextjs:nodejs --from=builder /app/package.json ./package.json
COPY --chown=nextjs:nodejs --from=builder /app/scripts ./scripts
COPY --chown=nextjs:nodejs --from=builder /app/extraction_resume_JD_score_report ./extraction_resume_JD_score_report
# The billing subprocess is spawned by lib/usage-metrics.ts with
# cwd = <process.cwd()>/livekit-python-agent and invoked as `python -m billing.billing`.
# These MUST therefore land under /app/livekit-python-agent/ (not flattened to /app),
# otherwise the subprocess fails to launch and JD/resume extraction costs never get
# recorded in the billing section.
COPY --chown=nextjs:nodejs --from=builder /app/livekit-python-agent/billing ./livekit-python-agent/billing
# billing.py imports from interview.agent_runtime_support / interview.agent_utils --
# both lightweight (dotenv + pydantic only), no heavy livekit-agents/asyncpg deps pulled in.
COPY --chown=nextjs:nodejs --from=builder /app/livekit-python-agent/interview ./livekit-python-agent/interview
# agent_persistence.py resolves the Supabase CA at <module>/../../certs/supabase-root-ca.pem,
# i.e. /app/livekit-python-agent/certs/ once the modules live under livekit-python-agent/.
COPY --chown=nextjs:nodejs --from=builder /app/certs ./livekit-python-agent/certs
COPY --chown=nextjs:nodejs --from=builder /app/lib ./lib
COPY --chown=nextjs:nodejs --from=builder /app/prisma ./prisma
COPY --chown=nextjs:nodejs --from=builder /app/certs ./certs
COPY --chown=nextjs:nodejs --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --chown=nextjs:nodejs --from=builder /app/worker.ts ./worker.ts
COPY --chown=nextjs:nodejs --from=builder /app/tsconfig.json ./tsconfig.json
COPY --chown=nextjs:nodejs --from=builder /app/next.config.ts ./next.config.ts
COPY --chown=nextjs:nodejs --from=builder /app/instrumentation.ts ./instrumentation.ts

USER nextjs

EXPOSE 3000

# Apply any pending migrations against the real DB, then start.
# migrate deploy only runs already-committed migration files (prisma/migrations/) --
# never db push in prod, and never migrate dev (that can prompt/reset).
CMD ["sh", "-c", "npx prisma migrate deploy && npm start"]
