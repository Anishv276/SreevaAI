# =============================================================================
# SreevaAI production env — copy to `.env` on the box and fill in.
#   cp .env.production.example .env && chmod 600 .env
# Keys below are every var referenced in the TS/Python code. Never commit .env.
# =============================================================================

# ---- Core / app -------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.sreevaai.com
ALLOWED_ORIGINS=https://www.sreevaai.com,https://sreevaai.com
JWT_SECRET=                      # long random string (openssl rand -hex 32)
MASTER_ADMIN_EMAIL=
WORKER_SYNC_TOKEN=               # shared secret for worker<->app sync

# ---- TLS (Traefik / Let's Encrypt) -----------------------------------------
ACME_EMAIL=                      # email for Let's Encrypt cert notices

# ---- Database: Supabase Postgres (kept) ------------------------------------
DATABASE_URL=                    # pooled (pgbouncer) URL — runtime
DIRECT_URL=                      # direct URL — used by `prisma migrate deploy`
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (container on the box) ------------------------------------------
REDIS_URL=redis://redis:6379

# ---- LiveKit (SELF-HOSTED on this box) -------------------------------------
# Browser + server connect via Traefik TLS at lk.sreevaai.com. The python agent
# overrides LIVEKIT_URL to ws://livekit:7880 internally (set in compose).
# Generate the key/secret yourself:
#   LIVEKIT_API_KEY=APIsreeva$(openssl rand -hex 4)
#   LIVEKIT_API_SECRET=$(openssl rand -hex 32)
# The SAME pair is used by: token minting (app), the livekit `keys:` block, and egress.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=

# ---- Cloudflare R2 (kept, S3-compatible) -----------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RESUMES_BUCKET=
R2_INTERVIEW_BUCKET=
R2_JDS_BUCKET=
R2_LOGOS_BUCKET=
NEXT_PUBLIC_R2_RESUMES_URL=
NEXT_PUBLIC_R2_INTERVIEW_URL=
NEXT_PUBLIC_R2_JDS_URL=
NEXT_PUBLIC_R2_LOGOS_URL=
S3_DELETE_LOGS=false

# ---- AI / STT / TTS providers ----------------------------------------------
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
SARVAM_API_KEY=

# ---- Vector DB (Pinecone) ---------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_SYNC_CHUNK_SIZE_CHARS=

# ---- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_WELCOME=
RESEND_FROM_PASSWORD_RESET=
RESEND_FROM_INTERVIEW=

# ---- Behaviour flags --------------------------------------------------------
INTERVIEW_TOKEN_REQUIRED=true
INTERVIEW_ALLOW_REOPEN=false
DEBUG_INTERVIEW_API=false
PYTHON_BIN=python3
