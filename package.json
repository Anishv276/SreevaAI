{
  "name": "hr_automation_platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev --turbo",
    "dev:web": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev --turbo",
    "agent": "python agent.py start",
    "agent:dev": "python agent.py dev",
    "dev:worker": "cross-env WORKER_QUEUES=resume-processing,invitation-delivery-queue,interview-start,interview-finalization,interview-snapshots,interview-recording,recording-retention-cleanup,jd-upload,jd-extraction,backup-queue tsx --env-file=.env worker.ts",
    "worker": "cross-env WORKER_QUEUES=resume-processing,invitation-delivery-queue,interview-start,interview-finalization,interview-snapshots,interview-recording,recording-retention-cleanup,jd-upload,jd-extraction tsx --env-file=.env worker.ts",
    "worker:resume": "cross-env WORKER_QUEUES=resume-processing tsx --env-file=.env worker.ts",
    "worker:invitation": "cross-env WORKER_QUEUES=invitation-delivery-queue tsx --env-file=.env worker.ts",
    "worker:backup": "cross-env WORKER_QUEUES=backup-queue tsx --env-file=.env worker.ts",
    "worker:interview": "cross-env WORKER_QUEUES=interview-start,interview-finalization,interview-snapshots,interview-recording,recording-retention-cleanup tsx --env-file=.env worker.ts",
    "worker:jd": "cross-env WORKER_QUEUES=jd-upload,jd-extraction tsx --env-file=.env worker.ts",
    "worker:all": "cross-env WORKER_QUEUES=resume-processing,invitation-delivery-queue,backup-queue,interview-start,interview-finalization,interview-snapshots,interview-recording,recording-retention-cleanup,jd-upload,jd-extraction tsx --env-file=.env worker.ts",
    "clean": "node scripts/clean-next.mjs",
    "postinstall": "node scripts/fix-prisma-runtime-compat.cjs",
    "prebuild": "npm run clean",
    "build": "next build --webpack",
    "typecheck": "npm run clean && tsc --noEmit",
    "start": "next start",
    "lint": "eslint"
  },
