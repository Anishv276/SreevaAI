    "next": "16.1.6",
    "openai": "^6.22.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.1",
    "uuid": "^13.0.0",
