# ═══════════════════════════════════════════════════════════════════
# .env.example — Copy this to .env and fill in your own values.
# Never commit .env to git — it contains secrets.
# ═══════════════════════════════════════════════════════════════════

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://default:<password>@<host>:<port>


# ── LiveKit Cloud ───────────────────────────────────────────────────
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>


# ── AI Providers ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
CARTESIA_API_KEY=sk_car_...
SARVAM_API_KEY=sk_...
DEEPGRAM_API_KEY=<your-deepgram-key>


# ── Cloudflare R2 Infrastructure ────────────────────────────────────
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<your-r2-access-key>"
R2_SECRET_ACCESS_KEY="<your-r2-secret-key>"
R2_LOGOS_BUCKET="logos"
R2_RESUMES_BUCKET="resumes"
R2_JDS_BUCKET="jds"
R2_INTERVIEW_BUCKET="interview"
NEXT_PUBLIC_R2_LOGOS_URL="https://pub-<id>.r2.dev"
NEXT_PUBLIC_R2_RESUMES_URL="https://pub-<id>.r2.dev"
NEXT_PUBLIC_R2_JDS_URL="https://pub-<id>.r2.dev"
NEXT_PUBLIC_R2_INTERVIEW_URL="https://pub-<id>.r2.dev"


# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<your-project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"


# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"


# ── Security ──────────────────────────────────────────────────────────
MASTER_ADMIN_EMAIL="support@sreevaai.com"
JWT_SECRET="<generate-a-random-64-char-hex-string>"

# ── Resend (Email) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_INTERVIEW="Sreeva AI <interviews@sreevaai.com>"
RESEND_FROM_PASSWORD_RESET="Sreeva AI <no-reply@sreevaai.com>"
RESEND_FROM_WELCOME="Sreeva AI <hello@sreevaai.com>"


# ── App URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"


# ── Slack ─────────────────────────────────────────────────────────────
# REQUIRED for debug PDF uploads after test interviews and error alerting.
#
# SLACK_BOT_TOKEN — Bot User OAuth Token (xoxb-...)
#   How to get: api.slack.com/apps -> OAuth & Permissions -> Bot Token
#   Scopes needed: files:write, chat:write
#   Ask the team lead for the shared token.
SLACK_BOT_TOKEN=xoxb-...

# SLACK_DEBUG_CHANNEL — Channel ID where debug PDFs are posted after test interviews.
#   How to get: Right-click channel in Slack -> View channel details -> copy ID (e.g. C01234ABCDE)
#   Ask the team lead for the channel ID.
SLACK_DEBUG_CHANNEL=C...

# SLACK_ERROR_WEBHOOK_URL — Webhook URL for error alerts (used by slack_error_logger.py)
#   How to get: api.slack.com/apps -> Incoming Webhooks -> Add New Webhook
SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# SLACK_ERROR_CHANNEL — Channel name for error alerts (optional, defaults to #debug-alerts)
SLACK_ERROR_CHANNEL=#debug-alerts


# ── App Mode ────────────────────────────────────────────────────────
# APP_MODE=test  → skips slot booking, interview link works immediately (QA only)
# APP_MODE=prod (or unset) → normal slot-booking flow enforced
APP_MODE=prod


# ── Worker Queue Configuration ────────────────────────────────────────
WORKER_QUEUES=resume-processing,interview-recording,interview-finalization,interview-snapshots,invitation-delivery-queue,jd-upload
# IMPORTANT: Use "dev" locally to avoid stealing prod jobs on the shared Redis.
# Prod MUST use: BULLMQ_PREFIX=prod
BULLMQ_PREFIX=dev
